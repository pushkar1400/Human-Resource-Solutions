                                                <rect key="frame" x="30" y="264" width="964" height="52"/>
                                                <attributedString key="attributedText">
                                                    <fragment content="ANTI-DISCRIMINATION NOTICE:">
                                                        <attributes>
                                                            <font key="NSFont" size="15" name="Helvetica-Bold"/>
                                                        </attributes>
                                                    </fragment>
                                                    <fragment content=" It is illegal to discriminate against work-authorized individuals. Employers ">
                                                        <attributes>
                                                            <font key="NSFont" size="15" name="Helvetica"/>
                                                        </attributes>
                                                    </fragment>
                                                    <fragment content="CANNOT">
                                                        <attributes>
                                                            <font key="NSFont" size="15" name="Helvetica-Bold"/>
                                                        </attributes>
                                                    </fragment>
                                                    <fragment>
                                                        <string key="content"> specify which document(s) an employee may present to establish employment authorization and identity. The refusal to hire or continue to employ an individual because thedocumentation presented has a future expiration date may also constitute illegal discrimination</string>
                                                        <attributes>
                                                            <font key="NSFont" size="15" name="Helvetica"/>
                                                        </attributes>
                                                    </fragment>
                                                </attributedString>
                                                <nil key="highlightedColor"/>
                                            </label>
