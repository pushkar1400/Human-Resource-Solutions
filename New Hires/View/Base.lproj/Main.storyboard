                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ROZ-dN-yXK">
                                                <rect key="frame" x="20" y="2394.5" width="984" height="17.5"/>
                                                <string key="text">The (Autofill Employer) Accident Prevention Plan is part of our Company Policy, and the company disciplinary policy can be used to enforce it. </string>
                                                <fontDescription key="fontDescription" name="Helvetica" family="Helvetica" pointSize="15"/>
                                                <nil key="textColor"/>
                                                <nil key="highlightedColor"/>
                                            </label>
