                                                                    <fragment content="NOTE TO EMPLOYEES:">
                                                                        <attributes>
                                                                            <font key="NSFont" size="15" name="Helvetica-Bold"/>
                                                                        </attributes>
                                                                    </fragment>
                                                                    <fragment>
                                                                        <string key="content">  Do not sign unless items on page 2 are covered and ALL questions are satisfactorily answered.
